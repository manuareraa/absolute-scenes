{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Event",
  "description": "A match event, from the simulator (ground truth) or detected from video.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "t", "type", "actors", "source", "confidence"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "t": { "type": "integer", "minimum": 0, "description": "Match clock in ms." },
    "type": {
      "type": "string",
      "enum": [
        "kickoff", "pass", "carry", "dribble", "shot", "save", "goal", "tackle", "interception",
        "clearance", "press", "foul", "card", "offside", "ball_out", "throw_in", "goal_kick",
        "corner", "free_kick", "penalty", "substitution", "var_check", "var_decision", "period_end"
      ]
    },
    "actors": { "type": "array", "items": { "type": "string" }, "description": "Player ids; the first is the main actor." },
    "team": { "type": "string", "enum": ["home", "away"] },
    "attrs": { "type": "object", "description": "Type-specific details, e.g. pass end point, outcome, xG." },
    "source": { "type": "string", "enum": ["sim", "video"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
