{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "show.schema.json",
  "title": "Show",
  "description": "A post-match drawn tactical show for one team, lens and language.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "match_id", "side", "lens", "lang", "segments"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "match_id": { "type": "string", "minLength": 1 },
    "side": { "type": "string", "enum": ["home", "away", "neutral"] },
    "lens": { "type": "string", "enum": ["casual", "analyst", "newcomer"] },
    "lang": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "created_at": { "type": "string", "format": "date-time" },
    "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Segment" } }
  },
  "$defs": {
    "Segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter_title", "overlay"],
      "properties": {
        "chapter_title": { "type": "string", "minLength": 1 },
        "audio_url": { "type": "string" },
        "overlay": { "$ref": "overlay.schema.json" }
      }
    }
  }
}
